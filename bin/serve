#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "$0")/.." && pwd -P)"
commons_dir="${INATOR_COMMONS_DIR:-$project_dir/../inator}"
if [[ ! -x "$commons_dir/node_modules/.bin/inator-serve" && -x "$project_dir/../../inator/node_modules/.bin/inator-serve" ]]; then
  commons_dir="$(cd "$project_dir/../../inator" && pwd -P)"
fi
launcher="$commons_dir/node_modules/.bin/inator-serve"

if [[ ! -x "$launcher" ]]; then
  printf 'Inator Commons launcher is unavailable: %s\n' "$launcher" >&2
  printf 'Set INATOR_COMMONS_DIR to the Inator Commons checkout.\n' >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  printf 'Bookinator needs Python 3. Install it, then run ./bin/serve again.\n' >&2
  exit 1
fi
project_version="$(python3 -c 'import pathlib,sys,tomllib; print(tomllib.loads(pathlib.Path(sys.argv[1]).read_text())["project"]["version"])' "$project_dir/pyproject.toml")"
exec env \
  INATOR_PROJECT_DIR="$project_dir" \
  INATOR_SHARED_LAUNCHER=1 \
  PYTHONPATH="$project_dir${PYTHONPATH:+:$PYTHONPATH}" \
  PORT="${PORT:-4890}" \
  SERVE_PROJECT_NAME="Bookinator" \
  SERVE_BANNER_TITLE="Bookinator" \
  SERVE_PROJECT_VERSION="$project_version" \
  SERVE_HEALTH_PATH="/api/health" \
  SERVE_BROWSER="${SERVE_BROWSER:-Safari}" \
  "$launcher" "$@" -- python3 -m bookinator.server --host @HOST@ --port @PORT@
