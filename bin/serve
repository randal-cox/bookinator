#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "$0")/.." && pwd -P)"
launcher="$project_dir/node_modules/.bin/inator-serve"

if [[ ! -x "$launcher" ]]; then
  printf 'Installed Inator launcher is unavailable: %s\n' "$launcher" >&2
  printf 'Run npm install, then use ./bin/inator doctor for details.\n' >&2
  exit 1
fi

python_bin="$project_dir/.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
  python_bin="$(command -v python3 || true)"
fi
if [[ -z "$python_bin" || ! -x "$python_bin" ]]; then
  printf 'Bookinator needs Python 3. Install it, then run ./bin/serve again.\n' >&2
  exit 1
fi
project_version="$("$python_bin" -c 'import pathlib,sys,tomllib; print(tomllib.loads(pathlib.Path(sys.argv[1]).read_text())["project"]["version"])' "$project_dir/pyproject.toml")"
serve_environment=(
  "INATOR_PROJECT_DIR=$project_dir"
  'INATOR_SHARED_LAUNCHER=1'
  "PYTHONPATH=$project_dir${PYTHONPATH:+:$PYTHONPATH}"
  "PORT=${PORT:-4890}"
  'SERVE_PROJECT_NAME=Bookinator'
  'SERVE_BANNER_TITLE=Bookinator'
  "SERVE_PROJECT_VERSION=$project_version"
  'SERVE_HEALTH_PATH=/api/health'
  "SERVE_BROWSER=${SERVE_BROWSER:-Safari}"
)

exec env "${serve_environment[@]}" "$launcher" "$@" -- "$python_bin" -m bookinator.server --host @HOST@ --port @PORT@
