{
  "schemaVersion": "inator-local-requirements.0.1-draft",
  "productId": "book.inator",
  "profiles": [
    { "id": "local-full", "label": "Local workbench", "execution": "local-compute", "publication": "private", "description": "Imports manuscripts and runs every local analysis stage." },
    { "id": "published-reader", "label": "Published reader", "execution": "publication-only", "publication": "public", "description": "Reads prepared Bookinator artifacts without local model infrastructure." }
  ],
  "requirements": [
    { "id": "python", "label": "Python", "kind": "runtime", "profiles": ["local-full"], "version": ">=3.11", "command": "python3", "purpose": "Book server, document ingestion, and isolated specialist runtimes." },
    { "id": "uv-or-pip", "label": "Python package installer", "kind": "command", "profiles": ["local-full"], "command": "uv", "required": false, "purpose": "Installs managed Python components; pip is an accepted fallback." },
    { "id": "pymupdf", "label": "PyMuPDF", "kind": "python-package", "profiles": ["local-full"], "package": "PyMuPDF", "version": ">=1.26,<2", "purpose": "Local PDF and normalized manuscript ingestion.", "install": { "strategy": "managed-python", "approval": "required" } },
    { "id": "ollama", "label": "Ollama", "kind": "model-provider", "profiles": ["local-full"], "provider": "official-or-managed", "command": "ollama", "capabilities": ["chat", "structured-output"], "purpose": "Local chapter reading and synthesis.", "install": { "strategy": "guided-official", "url": "https://ollama.com/download", "approval": "required" } },
    { "id": "qwen-primary", "label": "Primary Qwen reader", "kind": "model", "profiles": ["local-full"], "provider": "ollama", "package": "qwen3.8:27b", "purpose": "Deep reading and editorial analysis." },
    { "id": "qwen-fast", "label": "Fast Qwen reader", "kind": "model", "profiles": ["local-full"], "provider": "ollama", "package": "qwen2.5:7b", "purpose": "Intake and inexpensive utilities." },
    { "id": "gliner2", "label": "GLiNER 2 specialist", "kind": "python-package", "profiles": ["local-full"], "provider": "isolated-python-hugging-face", "package": "gliner2", "purpose": "Source-anchored entity and classification candidates." },
    { "id": "emotion-classifier", "label": "Hartmann emotion classifier", "kind": "library", "profiles": ["local-full"], "provider": "hugging-face", "package": "j-hartmann/emotion-english-distilroberta-base", "purpose": "Passage-level emotion scoring." },
    { "id": "prepared-book", "label": "Prepared Bookinator artifact", "kind": "library", "profiles": ["local-full", "published-reader"], "purpose": "Inspectable read-only publication input." }
  ]
}
